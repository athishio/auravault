# Gemini API Key
API_KEY=

# Shared secret gate token for single-user validation (must match frontend)
API_SECRET=

# AWS Credentials (DynamoDB access)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS Configuration (Comma-separated list of client domains, e.g. http://localhost:3000,https://auravault-two.vercel.app)
ALLOWED_ORIGIN=

# Flask debug flag (set to false in production)
FLASK_DEBUG=
